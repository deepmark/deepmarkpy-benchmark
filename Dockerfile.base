FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libgomp1 \
    git \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Constraints capture the image's currently-resolved dependency set
# (REORG_PLAN P0.2 freeze-in-place; a no-op at capture time).
COPY constraints.base.txt /constraints.base.txt
RUN pip install --no-cache-dir \
    -c /constraints.base.txt \
    torch==2.7.1 \
    torchaudio \
    numpy \
    scipy \
    fastapi \
    uvicorn \
    pydantic \
    librosa \
    soundfile \
    transformers

# Set up working directory
WORKDIR /app

# Copy shared utilities (this appears in all your dockerfiles)
COPY src/utils ./utils

# Set up Python path
ENV PYTHONPATH=/app:$PYTHONPATH