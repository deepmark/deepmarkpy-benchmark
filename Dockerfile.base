FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libgomp1 \
    git \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# cpu (the default) or a CUDA build such as cu126 for the GPU variant of
# every service built on this image; scripts/build_images.py passes it. The
# constraint pins torch==2.7.1, which either local build satisfies.
ARG TORCH_VARIANT=cpu

COPY constraints.base.txt /constraints.base.txt
RUN pip install --no-cache-dir --timeout 600 \
    -c /constraints.base.txt \
    torch==2.7.1+${TORCH_VARIANT} \
    torchaudio==2.7.1+${TORCH_VARIANT} \
    --extra-index-url https://download.pytorch.org/whl/${TORCH_VARIANT} \
    numpy \
    scipy \
    fastapi \
    uvicorn \
    pydantic \
    librosa \
    soundfile \
    transformers

# Set up working directory
WORKDIR /app

# Install the deepmarkpy package (modules only; runtime deps are the
# image's own frozen set)
COPY pyproject.toml README.md LICENSE /tmp/deepmarkpy-pkg/
COPY src/deepmarkpy /tmp/deepmarkpy-pkg/src/deepmarkpy
RUN pip install --no-cache-dir --no-deps /tmp/deepmarkpy-pkg && rm -rf /tmp/deepmarkpy-pkg

# Set up Python path
ENV PYTHONPATH=/app:$PYTHONPATH