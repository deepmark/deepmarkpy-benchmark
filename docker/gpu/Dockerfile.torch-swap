# GPU variant of a service image that installs its own torch rather than
# inheriting the base's: the CPU image with only the torch (and, where given,
# torchaudio) build swapped for a CUDA one. Everything else stays as built.
# scripts/build_images.py supplies the arguments per service:
#   speech_enhancement2      torch==2.13.0+cu130                            (cu130)
#   silentcipher, timbrewm   torch==2.0.0+cu118 torchaudio==2.0.1+cu118     (cu118)
# The x86 PyPI torch==2.0.0 is the cu117 build, which has no Hopper (sm_90)
# kernels; cu118 does.
ARG BASE
FROM ${BASE}

ARG TORCH_PACKAGES
ARG TORCH_INDEX
RUN test -n "${TORCH_PACKAGES}" && test -n "${TORCH_INDEX}" && \
    pip install --no-cache-dir ${TORCH_PACKAGES} \
        --index-url https://download.pytorch.org/whl/${TORCH_INDEX} \
        --extra-index-url https://pypi.org/simple

# cuDNN 8 (torch 2.0 + cu118) dlopens an unversioned libnvrtc.so that the
# wheel ships only as libnvrtc-<hash>.so.11.2; without the link the first conv
# aborts with SIGABRT. Newer torch builds need nothing here.
RUN lib=$(python -c "import os, torch; print(os.path.join(os.path.dirname(torch.__file__), 'lib'))") && \
    nvrtc=$(ls "$lib"/libnvrtc-*.so.11.2 2>/dev/null | head -n 1) && \
    mkdir -p /opt/nvrtc && \
    if [ -n "$nvrtc" ]; then ln -sf "$nvrtc" /opt/nvrtc/libnvrtc.so; fi
ENV LD_LIBRARY_PATH=/opt/nvrtc
