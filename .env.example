# .env.example — copy to .env before starting the services:
#     cp .env.example .env
#
# HOST is the address uvicorn binds INSIDE each container, so it must stay
# 0.0.0.0: a container that listened only on its own loopback could not be
# reached by Docker's port forwarding at all. What keeps the services off the
# network is the publish side in docker-compose.yml, which binds every port to
# 127.0.0.1 on the host.
HOST = "0.0.0.0"

# model ports
AUDIOSEAL_PORT=5001
SILENTCIPHER_PORT=7001
WAVMARK_PORT=8001
TIMBREWM_PORT=9001
PERTH_PORT=7010
AWARE_PORT=9004

# attack ports
VAE_PORT=10001
ENCODEC_PORT=10007
DESCRIPT_AUDIO_CODEC_PORT=10008
DIFFUSION_PORT=10002
SPEECH_TOKENIZATION_PORT=10003
NEURAL_VOCODER_PORT=10004
SPEECH_ENHANCEMENT_PORT1=10005
SPEECH_ENHANCEMENT_PORT2=10006
NETWORK_TRANSMISSION_PORT=10020
OPUS_CODEC_PORT=10023
