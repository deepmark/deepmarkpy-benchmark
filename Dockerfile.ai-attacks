FROM package-runtime AS speech-tokenization

# XCodec2 pins packaging==24.1 and ninja==1.11.1.1. pip>24.0 incorrectly
# reports that otherwise runnable Ninja wheel as unsupported with that
# packaging release, so keep pip 24.0 for this isolated legacy environment.
RUN python -m pip install --no-cache-dir "pip==24.0" \
    && python -m pip install --no-cache-dir ".[speech-tokenization,server]" \
    && python -m pip check

ENV APP_PORT=10003
CMD ["sh", "-c", "uvicorn deepmarkpy.plugins.attacks.speech_tokenization.app:app --host=${HOST} --port=${APP_PORT}"]


FROM package-runtime AS neural-vocoder

ARG BIGVGAN_COMMIT=7d2b454564a6c7d014227f635b7423881f14bdac
RUN git init BigVGAN \
    && git -C BigVGAN fetch --depth 1 \
        https://github.com/NVIDIA/BigVGAN.git "${BIGVGAN_COMMIT}" \
    && git -C BigVGAN checkout --detach FETCH_HEAD \
    && test "$(git -C BigVGAN rev-parse HEAD)" = "${BIGVGAN_COMMIT}"

RUN python -m pip install --no-cache-dir \
        --constraint constraints/ai-modern.txt \
        ".[neural-vocoder,server]" \
    && python -m pip check

ENV APP_PORT=10004
CMD ["sh", "-c", "uvicorn deepmarkpy.plugins.attacks.neural_vocoder.app:app --host=${HOST} --port=${APP_PORT}"]


