# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm AS package-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    git \
    libgomp1 \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/deepmarkpy

COPY pyproject.toml README.md LICENSE ./
COPY constraints ./constraints
COPY src ./src

RUN python -m pip install --no-cache-dir --upgrade pip

ENV HOST=0.0.0.0


FROM package-runtime AS vae

RUN python -m pip install --no-cache-dir \
    --constraint constraints/ai-modern.txt \
    ".[vae,server]" \
    && python -m pip check

ENV APP_PORT=10001
CMD ["sh", "-c", "uvicorn deepmarkpy.plugins.attacks.vae.app:app --host=${HOST} --port=${APP_PORT}"]


