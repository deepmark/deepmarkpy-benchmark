{
  "_doc": [
    "Parity gate per (service, operation): the tier it must meet, the evidence it must produce, and how to run it.",
    "Tiers are defined in src/deepmarkpy/parity/tiers.py (bounds from the GPU plan, decision D1).",
    "inputs: corpus input sets. 'clean' is the corpus itself; 'wm_audioseal' is the CPU reference embed of it,",
    "  so every attack sees the same watermarked audio on CPU and GPU (one variable at a time).",
    "params: the request-level parameters the benchmark's client sends (attack.py), so parity runs what runs.",
    "detector: the model whose CPU detector decodes bits from both outputs, for the 'bits' evidence.",
    "STOCHASTIC ops are judged on distributions, not by these tiers, and are listed for completeness."
  ],
  "audioseal": {
    "ops": {
      "embed": {
        "tier": "NUMERIC",
        "inputs": [
          "clean"
        ],
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      },
      "detect": {
        "tier": "NUMERIC",
        "inputs": [
          "wm_audioseal",
          "clean"
        ],
        "evidence": [
          "repeat",
          "bits",
          "confidence"
        ]
      }
    }
  },
  "encodec": {
    "ops": {
      "apply": {
        "tier": "QUANTIZED",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {},
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "descript_audio_codec": {
    "ops": {
      "apply": {
        "tier": "QUANTIZED",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {
          "n_codebooks_dac": 9
        },
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "neural_vocoder": {
    "cwd": "/app/BigVGAN",
    "ops": {
      "apply": {
        "tier": "NUMERIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {},
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "speech_tokenization": {
    "mount_cache": false,
    "ops": {
      "apply": {
        "tier": "NUMERIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {},
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "speech_enhancement1": {
    "ops": {
      "apply": {
        "tier": "NUMERIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {
          "noise_strength": 0.01
        },
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "speech_enhancement2": {
    "ops": {
      "apply": {
        "tier": "NUMERIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {
          "model_name": "MossFormerGAN_SE_16K"
        },
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "diffusion": {
    "mounts": {
      "diffusers": "/app/diffusers"
    },
    "ops": {
      "apply": {
        "tier": "STOCHASTIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {
          "diffusion_steps": 5
        },
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  },
  "vae": {
    "mounts": {
      "models": "/app/models"
    },
    "ops": {
      "apply": {
        "tier": "STOCHASTIC",
        "inputs": [
          "wm_audioseal"
        ],
        "params": {},
        "evidence": [
          "signal",
          "repeat",
          "bits",
          "metrics"
        ],
        "detector": "audioseal"
      }
    }
  }
}
